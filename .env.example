# Public OAuth client identifier. Never add a client secret or access token.
VITE_GOOGLE_CLIENT_ID=
# Optional: only needed when drive.file cannot directly access the fixed folder.
# Enable Google Picker API in the same project; restrict the browser key by referrers.
VITE_GOOGLE_PICKER_API_KEY=
# Defaults to the numeric project prefix of the OAuth client ID.
VITE_GOOGLE_PROJECT_NUMBER=
